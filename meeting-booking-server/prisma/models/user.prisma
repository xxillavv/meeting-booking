model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  roomMemberships       RoomMember[]
  createdBookings       Booking[]
  bookingParticipations BookingParticipant[]

  @@map("users")
}
